-- clone: controlled contraction

-- VALID: clone produces two independent senders
{s : **!Int} |- clone s : (**!Int, **!Int)

-- VALID: each clone output can be independently dropped
{s : **!Int} |-
  let (s1, s2) = clone s in
  drop s1;
  drop s2
  : ()

-- VALID: chain cloning
{s : **!Int} |-
  let (s1, sR)  = clone s  in
  let (s2, s3)  = clone sR in
  drop s1; drop s2; drop s3
  : ()

-- INVALID: original s used after clone (s is consumed by clone)
{s : **!Int} |-
  let (s1, s2) = clone s in
  drop s; drop s1; drop s2
  : ()   -- ERROR: s consumed by clone

-- INVALID: clone applied to receiver
{r : **?Int} |- clone r : (**?Int, **?Int)   -- ERROR
