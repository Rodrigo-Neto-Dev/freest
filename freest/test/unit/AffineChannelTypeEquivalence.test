-- Affine wrapper equivalence under the post-migration architecture.
--
-- The W-grammar treats each wrapper as an opaque constructor whose
-- inner is reduced via standard bisimulation. The wrapper itself does
-- NOT collapse with its dual in the grammar, so we restrict to
-- *reflexivity tests* (each entry compares a wrapper with itself).
-- The structural Eq instance on Type recognizes two wrappers with
-- congruent inners as equal, so reflexivity passes via t == u.
--
-- Drive with: AffineEquivalenceSpec.

case **!(!Int; Close)
  == **!(!Int; Close)
  : 1C

case **?(?Int; Wait)
  == **?(?Int; Wait)
  : 1C

case **!(!Char; Skip; Close)
  == **!(!Char; Skip; Close)
  : 1C

case **?(?Char; Skip; Wait)
  == **?(?Char; Skip; Wait)
  : 1C

case **!(Skip; !Int; Close)
  == **!(Skip; !Int; Close)
  : 1C

case **?(Skip; ?Int; Wait)
  == **?(Skip; ?Int; Wait)
  : 1C

case **!(&{A: !Int; Close, B: !Char; Close})
  == **!(&{A: !Int; Close, B: !Char; Close})
  : 1C
