-- Interaction between **!T/**?T and linear session types !T;S / ?T;S

-- VALID: affine sender and linear channel coexist, consumed independently
{s : **!Int, c : !Int;End} |-
  sendA 0 s; drop s; send 1 c
  : ()

-- INVALID: use linear send (send) on affine sender
{s : **!Int} |- send 0 s : ()   -- ERROR: type mismatch

-- INVALID: use affine sendA on linear session channel
{c : !Int;End} |- sendA 0 c : ()   -- ERROR: type mismatch

-- VALID: receive from affine, forward over linear
{s : **!Int, c : !Int;End} |-
  sendA 0 s; drop s   -- hypothetically: value received and forwarded
  : ()

-- INVALID: pass **?Int where ?Int;End expected
{r : **?Int} |- (receive r : (Int, End))   -- ERROR

-- VALID: affine channel carries linear endpoint (channel of channels)
{s : **!(!Int;End)} |-
  -- s can send a linear endpoint, but that endpoint must be provided
  ()   -- illustrative; full program required for execution test
