-- Affine discipline in recursive functions

-- VALID: base case drops, recursive case sends and recurses
-- sendN : Int -> **!Int -> ()
-- sendN 0 s = drop s
-- sendN n s = sendA n s; sendN (n-1) s
wellTyped sendN : Int -> **!Int -> ()

-- INVALID: recursive call reuses s without clone
-- bad : **!Int -> ()
-- bad s = sendA 0 s; bad s
illTyped bad : **!Int -> ()

-- VALID: mutual recursion, each function consumes its sender
-- even : Int -> **!Int -> ()
-- even 0 s = drop s
-- even n s = sendA n s; odd (n-1) s
--
-- odd : Int -> **!Int -> ()
-- odd 0 s = drop s
-- odd n s = sendA n s; even (n-1) s
wellTyped even : Int -> **!Int -> ()
wellTyped odd  : Int -> **!Int -> ()

-- INVALID: mutual recursion where one branch escapes
-- f : Int -> **!Int -> ()
-- f 0 s = ()           -- ERROR: s not consumed
-- f n s = sendA n s; f (n-1) s
illTyped f : Int -> **!Int -> ()
