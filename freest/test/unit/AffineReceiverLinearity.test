-- Receiver **?T is strictly linear (no clone, no implicit dup)

-- VALID: receiver consumed exactly once
{r : **?Int} |- receiveA r : Maybe(Int, **?Int)

-- INVALID: receiver used after receiveA returns next receiver
-- (next receiver r' from Just is a fresh linear resource, not r)
{r : **?Int} |-
  case receiveA r of
    Nothing -> ()
    Just (_, r') -> receiveA r; ()   -- ERROR: r already consumed
  : ()

-- INVALID: receiver variable mentioned twice
{r : **?Int} |-
  let _ = receiveA r in
  let _ = receiveA r in
  ()
  : ()   -- ERROR

-- INVALID: clone applied to receiver
{r : **?Int} |- clone r : (**?Int, **?Int)   -- ERROR

-- VALID: chain of receivers from successive receiveA calls
{r0 : **?Int} |-
  case receiveA r0 of
    Nothing -> ()
    Just (_, r1) ->
      case receiveA r1 of
        Nothing -> ()
        Just (_, r2) -> drop r2   -- ERROR: drop not defined for receiver
  : ()
-- NOTE: r2 at end must be consumed by receiveA (Nothing branch), not dropped
